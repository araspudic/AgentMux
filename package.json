{
  "name": "agentmux",
  "productName": "AgentMux",
  "version": "1.0.4",
  "description": "tmux-style terminal multiplexer for Copilot CLI / Claude Code sessions",
  "author": { "name": "AgentMux", "email": "agentmux@localhost" },
  "homepage": "https://github.com/araspudic/AgentMux",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux deb AppImage",
    "dist:win": "electron-builder --win nsis portable -c.npmRebuild=false"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "local.agentmux",
    "productName": "AgentMux",
    "files": ["main.js", "preload.js", "wwwroot/**/*"],
    "asarUnpack": ["node_modules/node-pty/**"],
    "linux": {
      "target": ["deb", "AppImage"],
      "category": "Development",
      "executableName": "agentmux",
      "maintainer": "AgentMux <agentmux@localhost>",
      "synopsis": "tmux-style terminal multiplexer for AI coding CLIs"
    },
    "deb": {
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0", "libuuid1", "libsecret-1-0", "libgbm1",
        "libasound2t64 | libasound2"
      ],
      "afterInstall": "deb/after-install.sh",
      "afterRemove": "deb/after-remove.sh"
    },
    "win": {
      "target": ["nsis", "portable"],
      "executableName": "AgentMux"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "AgentMux-Setup-${version}.exe",
      "shortcutName": "AgentMux"
    },
    "portable": {
      "artifactName": "AgentMux-${version}-portable.exe"
    }
  }
}
